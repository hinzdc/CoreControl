# SARGAVERSE Release Keystore Configuration Template
# ----------------------------------------------------
# Copy this file to "keystore.properties" in the project root, or set
# the corresponding environment variables in your CI/CD runner.
# NEVER commit keystore.properties or keystore files into Git.

storeFile=/path/to/sargaverse-release.jks
storePassword=YourKeystorePasswordHere
keyAlias=sargaverse
keyPassword=YourKeyPasswordHere

# Supported Environment Variables alternative:
# KEYSTORE_PATH or RELEASE_KEYSTORE_PATH
# KEYSTORE_PASSWORD or RELEASE_KEYSTORE_PASSWORD
# KEY_ALIAS or RELEASE_KEY_ALIAS
# KEY_PASSWORD or RELEASE_KEY_PASSWORD
